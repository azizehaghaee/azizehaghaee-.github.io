# 16. RNG SAVE + ROBUST RESTORE
# ==================================================================================================

def get_rng_state():

    state = {
        "python":
            random.getstate(),

        "numpy":
            np.random.get_state(),

        "torch":
            torch.get_rng_state(),
    }

    if torch.cuda.is_available():

        state["cuda"] = (
            torch.cuda.get_rng_state_all()
        )

    return state


def _rng_to_cpu_byte_tensor(x):

    if isinstance(
        x,
        torch.Tensor
    ):

        return (
            x.detach()
            .cpu()
            .to(dtype=torch.uint8)
            .contiguous()
        )

    if isinstance(
        x,
        np.ndarray
    ):

        return (
            torch.from_numpy(x)
            .to(dtype=torch.uint8)
            .cpu()
            .contiguous()
        )

    if isinstance(
        x,
        (list, tuple)
    ):

        return torch.tensor(
            x,
            dtype=torch.uint8,
            device="cpu"
        ).contiguous()

    raise TypeError(
        f"Unsupported RNG type: {type(x)}"
    )


def restore_rng_state(state):

    if state is None:

        print(
            "⚠ RNG state unavailable."
        )

        return

    try:

        random.setstate(
            state["python"]
        )

        print(
            "✓ Python RNG restored"
        )

    except Exception as e:

        print(
            "⚠ Python RNG:",
            repr(e)
        )

    try:

        np.random.set_state(
            state["numpy"]
        )

        print(
            "✓ NumPy RNG restored"
        )

    except Exception as e:

        print(
            "⚠ NumPy RNG:",
            repr(e)
        )

    try:

        torch.set_rng_state(
            _rng_to_cpu_byte_tensor(
                state["torch"]
            )
        )

        print(
            "✓ Torch CPU RNG restored"
        )

    except Exception as e:

        print(
            "⚠ Torch CPU RNG:",
            repr(e)
        )

    try:

        if (
            torch.cuda.is_available()
            and
            "cuda" in state
            and
            state["cuda"] is not None
        ):

            cuda_state = (
                state["cuda"]
            )

            if isinstance(
                cuda_state,
                torch.Tensor
            ):

                cuda_state = [
                    cuda_state
                ]

            converted = [
                _rng_to_cpu_byte_tensor(x)
                for x in cuda_state
            ]

            n_devices = (
                torch.cuda.device_count()
            )

            if len(converted) >= n_devices:

                torch.cuda.set_rng_state_all(
                    converted[:n_devices]
                )

            elif len(converted) > 0:

                torch.cuda.set_rng_state(
                    converted[0],
                    device=0
                )

            print(
                "✓ CUDA RNG restored"
            )

    except Exception as e:

        print(
            "⚠ CUDA RNG:",
            repr(e)
        )


# ==================================================================================================
# 17. ATOMIC SAVE
# ==================================================================================================

def atomic_save(
    obj,
    path
):

    path = Path(path)

    tmp = path.with_suffix(
        path.suffix
        +
        ".tmp"
    )

    torch.save(
        obj,
        tmp
    )

    os.replace(
        tmp,
        path
    )


