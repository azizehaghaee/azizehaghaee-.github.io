def run_single_experiment(
    mode,
    seed
):

    print("\n\n")
    print("#" * 125)
    print(
        f"RUN: {MODE_LABELS[mode]} | SEED={seed}"
    )
    print("#" * 125)

    run_root = (
        MULTI_ROOT
        /
        mode
        /
        f"seed_{seed}"
    )

    checkpoint_dir = (
        run_root
        /
        "checkpoints"
    )

    run_root.mkdir(
        parents=True,
        exist_ok=True
    )

    checkpoint_dir.mkdir(
        parents=True,
        exist_ok=True
    )

    best_path = (
        checkpoint_dir
        /
        "best.pt"
    )

    last_path = (
        checkpoint_dir
        /
        "last.pt"
    )

    resume_path = (
        checkpoint_dir
        /
        "resume.pt"
    )

    history_csv = (
        run_root
        /
        "history.csv"
    )

    history_json = (
        run_root
        /
        "history.json"
    )

    final_json = (
        run_root
        /
        "final_validation_result.json"
    )

    config_json = (
        run_root
        /
        "config.json"
    )

    # ==============================================================================================
    # Already completed?
    # ==============================================================================================

    if final_json.exists():

        print(
            "✓ FINAL result already exists — skipping training."
        )

        with open(
            final_json,
            "r",
            encoding="utf-8"
        ) as f:

            result = json.load(f)

        return result

    # ==============================================================================================
    # CLEAN GPU
    # ==============================================================================================

    gc.collect()

    if torch.cuda.is_available():
        torch.cuda.empty_cache()

    # ==============================================================================================
    # IMPORTANT: reset seed immediately before model construction
    # ==============================================================================================

    set_seed(seed)

    model = SVTRMatchedAuxCTC(
        mode=mode,
        num_classes=NUM_CLASSES
    ).to(DEVICE)

    total_params = sum(
        p.numel()
        for p in model.parameters()
    )

    assert (
        total_params
        ==
        EXPECTED_AUX_PARAMS
    )

    init_hash = (
        parameter_hash(model)
    )

    print(
        "Initial parameter SHA256:",
        init_hash[:24] + "..."
    )

    print(
        "Parameters              :",
        f"{total_params:,}"
    )

    print(
        "Initial beta            :",
        float(
            model.backbone
            .get_beta()
            .detach()
            .cpu()
        )
    )

    # ==============================================================================================
    # LOADERS
    # ==============================================================================================

    train_sampler = EpochShuffleSampler(
        train_dataset,
        seed
    )

    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        sampler=train_sampler,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=True,
        drop_last=False,
        collate_fn=svtr_collate_fn,
        persistent_workers=(
            NUM_WORKERS > 0
        )
    )

    val_loader = DataLoader(
        val_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False,
        num_workers=NUM_WORKERS,
        pin_memory=True,
        drop_last=False,
        collate_fn=svtr_collate_fn,
        persistent_workers=(
            NUM_WORKERS > 0
        )
    )

    steps_per_epoch = len(
        train_loader
    )

    assert steps_per_epoch == 504

    # ==============================================================================================
    # OPTIMIZER GROUPS
    # ==============================================================================================

    decay_params = []
    no_decay_params = []

    decay_names = []
    no_decay_names = []

    for name, param in model.named_parameters():

        if not param.requires_grad:
            continue

        lname = name.lower()

        no_decay = (
            param.ndim <= 1
            or "norm" in lname
            or "pos_embed" in lname
            or name.endswith(".bias")
            or "beta_logit" in lname
        )

        if no_decay:

            no_decay_params.append(
                param
            )

            no_decay_names.append(
                name
            )

        else:

            decay_params.append(
                param
            )

            decay_names.append(
                name
            )

    print(
        "Decay tensors           :",
        len(decay_params)
    )

    print(
        "No-decay tensors        :",
        len(no_decay_params)
    )

    print(
        "beta no-decay           :",
        any(
            "beta_logit" in n
            for n in no_decay_names
        )
    )

    assert len(decay_params) == 58
    assert len(no_decay_params) == 119

    optimizer = torch.optim.AdamW(
        [
            {
                "params":
                    decay_params,

                "weight_decay":
                    WEIGHT_DECAY,
            },
            {
                "params":
                    no_decay_params,

                "weight_decay":
                    0.0,
            }
        ],
        lr=LR,
        betas=BETAS,
        eps=EPS
    )

    # ==============================================================================================
    # AMP + CTC
    # ==============================================================================================

    ctc_loss_fn = nn.CTCLoss(
        blank=BLANK_ID,
        reduction="mean",
        zero_infinity=True
    )

    scaler = torch.amp.GradScaler(
        "cuda",
        init_scale=AMP_INIT_SCALE,
        growth_factor=2.0,
        backoff_factor=0.5,
        growth_interval=2000,
        enabled=torch.cuda.is_available()
    )

    # ==============================================================================================
    # SCHEDULER
    # ==============================================================================================

    warmup_steps = (
        WARMUP_EPOCHS
        *
        steps_per_epoch
    )

    total_steps = (
        MAX_EPOCHS
        *
        steps_per_epoch
    )

    def lr_lambda(step):

        if step < warmup_steps:

            return (
                step + 1
            ) / max(
                warmup_steps,
                1
            )

        progress = (
            step
            -
            warmup_steps
        ) / max(
            total_steps
            -
            warmup_steps,
            1
        )

        progress = min(
            max(
                progress,
                0.0
            ),
            1.0
        )

        return (
            0.5
            *
            (
                1.0
                +
                math.cos(
                    math.pi
                    *
                    progress
                )
            )
        )

    scheduler = (
        torch.optim.lr_scheduler.LambdaLR(
            optimizer,
            lr_lambda=lr_lambda
        )
    )

    # ==============================================================================================
    # VALIDATION FUNCTION FOR THIS RUN
    # ==============================================================================================

    @torch.no_grad()
    def evaluate():

        model.eval()

        running_loss = 0.0
        total_samples = 0

        predictions = []
        references = []

        for batch in tqdm(
            val_loader,
            desc="Validation",
            leave=False
        ):

            images = batch[
                "images"
            ].to(
                DEVICE,
                non_blocking=True
            )

            targets = batch[
                "targets"
            ].to(
                DEVICE,
                non_blocking=True
            )

            target_lengths = batch[
                "target_lengths"
            ].to(
                DEVICE,
                non_blocking=True
            )

            B = images.shape[0]

            with torch.autocast(
                device_type="cuda",
                dtype=torch.float16,
                enabled=torch.cuda.is_available()
            ):

                logits = model(
                    images,
                    rtl=RTL_FINAL
                )

            log_probs = F.log_softmax(
                logits.float(),
                dim=-1
            ).transpose(
                0,
                1
            )

            input_lengths = torch.full(
                (B,),
                logits.shape[1],
                dtype=torch.long,
                device=DEVICE
            )

            loss = ctc_loss_fn(
                log_probs,
                targets,
                input_lengths,
                target_lengths
            )

            running_loss += (
                float(
                    loss
                    .detach()
                    .cpu()
                )
                *
                B
            )

            total_samples += B

            predictions.extend(
                decode_logits(
                    logits
                )
            )

            references.extend(
                batch["labels"]
            )

        metrics = calculate_metrics(
            predictions,
            references
        )

        metrics["loss"] = (
            running_loss
            /
            max(
                total_samples,
                1
            )
        )

        return metrics

    # ==============================================================================================
    # STATE
    # ==============================================================================================

    history = []

    best_val_cer = float("inf")
    best_val_loss = float("inf")

    best_epoch = 0

    epochs_without_improvement = 0

    resume_epoch = 1
    resume_batch = 0

    resume_loss_sum = 0.0
    resume_samples = 0
    resume_skipped = 0

    # ==============================================================================================
    # CHECKPOINT CREATOR
    # ==============================================================================================

    def make_checkpoint(
        epoch_to_resume,
        batch_to_resume,
        epoch_loss_sum,
        epoch_samples,
