                    .get_beta()
                    .detach()
                    .cpu()
                ),

            "test_evaluated":
                False,
        }

    # ==============================================================================================
    # CONFIG
    # ==============================================================================================

    run_config = {
        "mode":
            mode,

        "model":
            MODE_LABELS[mode],

        "seed":
            int(seed),

        "parameters":
            total_params,

        "initial_parameter_hash":
            init_hash,

        "train_samples":
            4025,

        "validation_samples":
            484,

        "test_samples":
            505,

        "test_evaluated":
            False,

        "batch_size":
            BATCH_SIZE,

        "lr":
            LR,

        "weight_decay":
            WEIGHT_DECAY,

        "betas":
            list(BETAS),

        "warmup_epochs":
            WARMUP_EPOCHS,

        "max_epochs":
            MAX_EPOCHS,

        "patience":
            PATIENCE,

        "grad_clip":
            GRAD_CLIP,

        "rtl":
            RTL_FINAL,

        "selection":
            "minimum Validation CER",
    }

    with open(
        config_json,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            run_config,
            f,
            ensure_ascii=False,
            indent=2
        )

    # ==============================================================================================
    # AUTO RESUME
    # ==============================================================================================

    checkpoint_to_load = None

    if resume_path.exists():

        checkpoint_to_load = (
            resume_path
        )

    elif last_path.exists():

        checkpoint_to_load = (
            last_path
        )

    if checkpoint_to_load is not None:

        print("\n" + "=" * 125)
        print(
            "EXISTING RUN CHECKPOINT FOUND — AUTO RESUME"
        )
        print("=" * 125)

        checkpoint = torch.load(
            checkpoint_to_load,
            map_location="cpu",
            weights_only=False
        )

        if checkpoint.get(
            "mode"
        ) != mode:

            raise RuntimeError(
                "Checkpoint mode mismatch."
            )

        if int(
            checkpoint.get(
                "seed"
            )
        ) != int(seed):

            raise RuntimeError(
                "Checkpoint seed mismatch."
            )

        if int(
            checkpoint.get(
                "parameters"
            )
        ) != EXPECTED_AUX_PARAMS:

            raise RuntimeError(
                "Checkpoint parameter mismatch."
            )

        model.load_state_dict(
            checkpoint[
                "model_state_dict"
            ],
            strict=True
        )

        model.to(
            DEVICE
        )

        optimizer.load_state_dict(
            checkpoint[
                "optimizer_state_dict"
            ]
        )

        optimizer_to_device(
            optimizer,
            DEVICE
        )

        scheduler.load_state_dict(
            checkpoint[
                "scheduler_state_dict"
            ]
        )

        scaler.load_state_dict(
            checkpoint[
                "scaler_state_dict"
            ]
        )

        resume_epoch = int(
            checkpoint.get(
                "resume_epoch",
                1
            )
        )

        resume_batch = int(
            checkpoint.get(
                "resume_batch",
                0
            )
        )

        resume_loss_sum = float(
            checkpoint.get(
                "epoch_loss_sum",
                0.0
            )
        )

        resume_samples = int(
            checkpoint.get(
                "epoch_samples",
                0
            )
        )

        resume_skipped = int(
            checkpoint.get(
                "epoch_skipped",
                0
            )
        )

        best_val_cer = float(
            checkpoint.get(
                "best_val_cer",
                float("inf")
            )
        )

        best_val_loss = float(
            checkpoint.get(
                "best_val_loss",
                float("inf")
            )
        )

        best_epoch = int(
            checkpoint.get(
                "best_epoch",
                0
            )
        )

        epochs_without_improvement = int(
            checkpoint.get(
                "epochs_without_improvement",
                0
            )
        )

        history = checkpoint.get(
            "history",
            []
        )

        restore_rng_state(
            checkpoint.get(
                "rng_state"
            )
        )

        print(
            "Checkpoint type :",
            checkpoint.get(
                "checkpoint_type"
            )
        )

        print(
            "Resume epoch    :",
            resume_epoch
        )

        print(
            "Resume batch    :",
            resume_batch
        )

        print(
            "Best epoch      :",
            best_epoch
        )

        if math.isfinite(
            best_val_cer
        ):

            print(
                "Best Val CER    :",
                f"{best_val_cer*100:.4f}%"
            )

        print(
            "Restored beta   :",
            float(
                model.backbone
                .get_beta()
                .detach()
                .cpu()
            )
        )

        print(
            "Current LR      :",
            optimizer
            .param_groups[0]["lr"]
        )

    else:

        print("\n" + "=" * 125)
        print(
            f"FRESH RUN — {MODE_LABELS[mode]} — SEED {seed}"
        )
        print("=" * 125)

    # ==============================================================================================
    # TRAINING
    # ==============================================================================================

    run_start = time.time()

    can_train = (
        resume_epoch <= MAX_EPOCHS
        and
        epochs_without_improvement < PATIENCE
    )

    if not can_train:

        print(
            "Training phase already complete; "
            "proceeding to final validation."
        )

    for epoch in range(
        resume_epoch,
        MAX_EPOCHS + 1
    ):

        if (
            epochs_without_improvement
            >=
            PATIENCE
        ):

            break

        epoch_start = time.time()

        train_sampler.set_epoch(
            epoch
        )

        start_batch = (
            resume_batch
            if epoch == resume_epoch
            else 0
        )

        if epoch == resume_epoch:

            running_loss = (
                resume_loss_sum
            )

            samples_seen = (
                resume_samples
            )

            skipped_steps = (
                resume_skipped
            )

        else:

            running_loss = 0.0
            samples_seen = 0
            skipped_steps = 0

        model.train()

        print("\n" + "-" * 125)

        print(
            f"{MODE_LABELS[mode]} | "
            f"SEED {seed} | "
            f"EPOCH {epoch:02d}/{MAX_EPOCHS}"
        )

        if start_batch > 0:

            print(
                f"Resuming at batch "
                f"{start_batch}/{steps_per_epoch}"
            )

        pbar = tqdm(
            enumerate(train_loader),
            total=steps_per_epoch,
            desc=(
                f"{mode} S{seed} "
                f"E{epoch:02d}"
            )
        )

        for batch_index, batch in pbar:

            if batch_index < start_batch:
                continue

            images = batch[
                "images"
            ].to(
                DEVICE,
                non_blocking=True
            )

            targets = batch[
                "targets"
            ].to(
                DEVICE,
                non_blocking=True
            )

            target_lengths = batch[
                "target_lengths"
            ].to(
                DEVICE,
                non_blocking=True
            )

            B = images.shape[0]

            optimizer.zero_grad(
                set_to_none=True
            )

            # --------------------------------------------------------------------------------------
            # FP16 forward
            # --------------------------------------------------------------------------------------

            with torch.autocast(
                device_type="cuda",
                dtype=torch.float16,
                enabled=torch.cuda.is_available()
            ):

                logits = model(
                    images,
                    rtl=RTL_FINAL
                )

            # --------------------------------------------------------------------------------------
            # FP32 CTC
            # --------------------------------------------------------------------------------------

            log_probs = F.log_softmax(
                logits.float(),
                dim=-1
            ).transpose(
                0,
                1
            )

            input_lengths = torch.full(
                (B,),
                logits.shape[1],
                dtype=torch.long,
                device=DEVICE
            )

            loss = ctc_loss_fn(
                log_probs,
                targets,
                input_lengths,
                target_lengths
            )

            if not torch.isfinite(
                loss
            ):

                skipped_steps += 1

                optimizer.zero_grad(
                    set_to_none=True
                )

                continue

            scaler.scale(
                loss
            ).backward()

            scaler.unscale_(
                optimizer
            )

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                GRAD_CLIP
            )

            scaler.step(
                optimizer
            )

            scaler.update()

            scheduler.step()

            loss_value = float(
                loss.detach().cpu()
            )

            running_loss += (
                loss_value
                *
                B
            )

            samples_seen += B

            beta = float(
                model.backbone
                .get_beta()
                .detach()
                .cpu()
            )

            current_lr = (
                optimizer
                .param_groups[0]["lr"]
            )

            pbar.set_postfix(
                {
                    "loss":
                        f"{loss_value:.3f}",

                    "lr":
                        f"{current_lr:.2e}",

                    "beta":
                        f"{beta:.4f}",

                    "scale":
                        f"{scaler.get_scale():.0f}",
                }
            )

            completed_batches = (
                batch_index
                +
                1
            )

            # --------------------------------------------------------------------------------------
            # Emergency save
            # --------------------------------------------------------------------------------------

            if (
                completed_batches
                %
                EMERGENCY_EVERY
                ==
                0
                and
                completed_batches
                <
                steps_per_epoch
            ):

                emergency_state = (
                    make_checkpoint(
                        epoch_to_resume=epoch,
                        batch_to_resume=completed_batches,
                        epoch_loss_sum=running_loss,
                        epoch_samples=samples_seen,
                        epoch_skipped=skipped_steps,
                        checkpoint_type="mid_epoch"
                    )
                )

                atomic_save(
                    emergency_state,
                    resume_path
                )

                print(
                    f"\n💾 Emergency checkpoint: "
                    f"{mode}, Seed {seed}, "
                    f"Epoch {epoch}, "
                    f"Batch {completed_batches}/{steps_per_epoch}"
                )

        # ==========================================================================================
        # END TRAIN EPOCH
        # ==========================================================================================

        resume_batch = 0
        resume_loss_sum = 0.0
        resume_samples = 0
        resume_skipped = 0

        train_loss = (
            running_loss
            /
            max(
                samples_seen,
                1
            )
        )

        # ==========================================================================================
        # VALIDATION
        # ==========================================================================================

        val = evaluate()

        val_cer = val["cer"]
        val_wer = val["wer"]
        val_line_acc = val[
            "line_acc"
        ]
        val_ned = val[
            "mean_1_ned"
        ]
        val_loss = val["loss"]

        beta = float(
            model.backbone
            .get_beta()
            .detach()
            .cpu()
        )

        beta_logit = float(
            model.backbone
            .beta_logit
            .detach()
            .cpu()
        )

        current_lr = (
            optimizer
            .param_groups[0]["lr"]
        )

        epoch_seconds = (
            time.time()
            -
            epoch_start
        )

        print("\n" + "-" * 125)

        print(
            f"{MODE_LABELS[mode]} | "
            f"Seed {seed} | "
            f"Epoch {epoch}"
        )

        print(
            f"Train Loss : {train_loss:.4f}"
        )

        print(
            f"Val Loss   : {val_loss:.4f}"
        )

        print(
            f"Val CER    : {val_cer*100:.4f}%"
        )

        print(
            f"Val WER    : {val_wer*100:.4f}%"
        )

        print(
            f"Val LineAcc: "
            f"{val_line_acc*100:.4f}%"
        )

        print(
            f"Val 1-NED  : "
            f"{val_ned*100:.4f}%"
        )

        print(
            f"beta       : {beta:.6f}"
        )

        print(
            f"LR         : {current_lr:.8f}"
        )

        print(
            f"AMP Scale  : "
            f"{scaler.get_scale():.0f}"
        )

        print(
            f"Skipped    : {skipped_steps}"
        )

        # ==========================================================================================
        # BEST BY VALIDATION CER
        # ==========================================================================================

        improved = (
            val_cer
            <
            best_val_cer
            -
            1e-8
            or
            (
                abs(
                    val_cer
                    -
                    best_val_cer
                )
                <=
                1e-8
                and
                val_loss
                <
                best_val_loss
            )
        )

        if improved:

            best_val_cer = val_cer
            best_val_loss = val_loss
            best_epoch = epoch

            epochs_without_improvement = 0

            print(
                "\n✓ NEW BEST CHECKPOINT"
            )

            print(
                "  Epoch:",
                best_epoch
            )

            print(
                "  CER  :",
                f"{best_val_cer*100:.4f}%"
            )

        else:

            epochs_without_improvement += 1

            print(
                "\nNo improvement:",
                f"{epochs_without_improvement}/{PATIENCE}"
            )

        # ==========================================================================================
        # HISTORY
        # ==========================================================================================

        row = {
            "epoch":
                int(epoch),

            "train_loss":
                float(train_loss),

            "val_loss":
                float(val_loss),

            "val_cer":
                float(val_cer),

            "val_wer":
                float(val_wer),

            "val_line_acc":
                float(val_line_acc),

            "val_1_ned":
                float(val_ned),

            "beta":
                float(beta),

            "beta_logit":
                float(beta_logit),

            "lr":
                float(current_lr),

            "amp_scale":
                float(
                    scaler.get_scale()
                ),

            "skipped":
                int(skipped_steps),

            "epoch_seconds":
                float(epoch_seconds),
        }

        history = [
            h
            for h in history
            if int(
                h["epoch"]
            ) != epoch
        ]

        history.append(row)

        history = sorted(
            history,
            key=lambda h:
                int(
                    h["epoch"]
                )
        )

        with open(
            history_json,
            "w",
            encoding="utf-8"
        ) as f:

            json.dump(
                history,
                f,
                ensure_ascii=False,
                indent=2
            )

        with open(
            history_csv,
            "w",
            newline="",
            encoding="utf-8"
        ) as f:

            writer = csv.DictWriter(
                f,
                fieldnames=list(
                    history[0].keys()
                )
            )

            writer.writeheader()
            writer.writerows(
                history
            )

        # ==========================================================================================
        # END-EPOCH CHECKPOINT
        # ==========================================================================================

        epoch_state = make_checkpoint(
            epoch_to_resume=epoch + 1,
            batch_to_resume=0,
            epoch_loss_sum=0.0,
            epoch_samples=0,
            epoch_skipped=0,
            checkpoint_type="end_epoch"
        )

        atomic_save(
            epoch_state,
            last_path
        )

        atomic_save(
            epoch_state,
            resume_path
        )

        if improved:

            atomic_save(
                epoch_state,
                best_path
            )

        print(
            "💾 End-of-epoch checkpoint saved."
        )

        # ==========================================================================================
        # EARLY STOP
        # ==========================================================================================

        if (
            epochs_without_improvement
            >=
            PATIENCE
        ):

            print(
                "\nEARLY STOPPING"
            )

            break

    # ==============================================================================================
    # LOAD BEST MODEL
    # ==============================================================================================

    if not best_path.exists():

        raise RuntimeError(
            f"Best checkpoint missing: {best_path}"
        )

    best_state = torch.load(
        best_path,
        map_location="cpu",
        weights_only=False
    )

    model.load_state_dict(
        best_state[
            "model_state_dict"
        ],
        strict=True
    )

    model.to(DEVICE)
    model.eval()

    # ==============================================================================================
    # FINAL VALIDATION — NO TEST
    # ==============================================================================================

    print("\n" + "=" * 125)

    print(
        f"FINAL VALIDATION | "
        f"{MODE_LABELS[mode]} | "
        f"SEED={seed}"
    )

    print("=" * 125)

    final_val = evaluate()

    result = {
        "seed":
            int(seed),

        "mode":
            mode,

        "model":
            MODE_LABELS[mode],

        "parameters":
            total_params,

        "initial_parameter_hash":
            init_hash,

        "best_epoch":
            int(
                best_state.get(
                    "best_epoch",
                    best_epoch
                )
            ),

        "beta":
            float(
                model.backbone
                .get_beta()
                .detach()
                .cpu()
            ),

        # Store all metrics as percentages for easy comparison
        "cer":
            float(
                final_val["cer"]
                *
                100
            ),

        "wer":
            float(
                final_val["wer"]
                *
                100
            ),

        "line_acc":
            float(
                final_val[
                    "line_acc"
                ]
                *
                100
            ),

        "ned":
            float(
                final_val[
                    "mean_1_ned"
                ]
                *
                100
            ),

        "loss":
            float(
                final_val["loss"]
            ),

        "test_evaluated":
            False,

        "source":
            "new_multiseed_run",

        "run_minutes_this_session":
            float(
                (
                    time.time()
                    -
                    run_start
                )
                /
                60.0
            ),
    }

    print(
        f"CER       : {result['cer']:.4f}%"
    )

    print(
        f"WER       : {result['wer']:.4f}%"
    )

    print(
        f"Line Acc  : {result['line_acc']:.4f}%"
    )

    print(
        f"1-NED     : {result['ned']:.4f}%"
    )

    print(
        f"Loss      : {result['loss']:.4f}"
    )

    print(
        f"Best epoch: {result['best_epoch']}"
    )

    print(
        f"beta      : {result['beta']:.6f}"
    )

    with open(
        final_json,
        "w",
        encoding="utf-8"
    ) as f:

        json.dump(
            result,
            f,
            ensure_ascii=False,
            indent=2
        )

    # ==============================================================================================
    # CLEAN MEMORY
    # ==============================================================================================

    del model
    del optimizer
    del scheduler
    del scaler
    del train_loader
    del val_loader
    del train_sampler
    del ctc_loss_fn

    gc.collect()

    if torch.cuda.is_available():
        torch.cuda.empty_cache()

    return result


