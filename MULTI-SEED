# 6. SAME CTC HEAD
# ==================================================================================================

class OfficialCTCHead(nn.Module):

    def __init__(
        self,
        in_channels=192,
        out_channels=68
    ):

        super().__init__()

        self.fc = nn.Linear(
            in_channels,
            out_channels
        )

        bound = (
            1.0
            /
            math.sqrt(in_channels)
        )

        nn.init.uniform_(
            self.fc.weight,
            -bound,
            bound
        )

        nn.init.uniform_(
            self.fc.bias,
            -bound,
            bound
        )

    def forward(self, x):

        return self.fc(x)


# ==================================================================================================
# 7. GENERIC PARAMETER-MATCHED AUXILIARY BRANCH
#
# IMPORTANT:
#
# Constructor is IDENTICAL for both modes.
#
# Only forward preprocessing differs:
#
#   no_contrast:
#       z = X
#
#   signed:
#       z = X - AvgPool3x3(X)
#
# Thus, for a given seed, both models begin with the same parameter initialization.
# ==================================================================================================

class MatchedAuxBranch(nn.Module):

    def __init__(
        self,
        mode,
        in_channels=128,
        hidden_channels=128,
        out_channels=256
    ):

        super().__init__()

        if mode not in {
            "no_contrast",
            "signed"
        }:
            raise ValueError(
                f"Unsupported mode: {mode}"
            )

        self.mode = mode

        self.proj = nn.Sequential(

            nn.Conv2d(
                in_channels,
                hidden_channels,
                kernel_size=1,
                stride=1,
                padding=0,
                bias=False
            ),

            nn.BatchNorm2d(
                hidden_channels
            ),

            nn.GELU()
        )

        self.depthwise = nn.Sequential(

            nn.Conv2d(
                hidden_channels,
                hidden_channels,
                kernel_size=3,
                stride=1,
                padding=1,
                groups=hidden_channels,
                bias=False
            ),

            nn.BatchNorm2d(
                hidden_channels
            ),

            nn.GELU()
        )

        self.pointwise = nn.Sequential(

            nn.Conv2d(
                hidden_channels,
                hidden_channels,
                kernel_size=1,
                stride=1,
                padding=0,
                bias=False
            ),

            nn.BatchNorm2d(
                hidden_channels
            ),

            nn.GELU()
        )

        self.downsample = nn.Sequential(

            nn.Conv2d(
                hidden_channels,
                out_channels,
                kernel_size=3,
                stride=(2, 1),
                padding=1,
                bias=False
            ),

            nn.BatchNorm2d(
                out_channels
            ),

            nn.GELU()
        )

    def forward(self, x):

        if self.mode == "no_contrast":

            z = x

        elif self.mode == "signed":

            local_mean = F.avg_pool2d(
                x,
                kernel_size=3,
                stride=1,
                padding=1
            )

            z = (
                x
                -
                local_mean
            )

        z = self.proj(z)
        z = self.depthwise(z)
        z = self.pointwise(z)
        z = self.downsample(z)

        return z


# ==================================================================================================
# 8. GENERIC MATCHED SVTR BACKBONE
# ==================================================================================================

class SVTRMatchedAuxBackbone(nn.Module):

    def __init__(
        self,
        mode
    ):

        super().__init__()

        self.mode = mode

        self.core = (
            SVTRTinyBackbone()
        )

        self.aux_branch = MatchedAuxBranch(
            mode=mode,
            in_channels=128,
            hidden_channels=128,
            out_channels=256
        )

        self.beta_logit = nn.Parameter(
            torch.tensor(
                -2.0,
                dtype=torch.float32
            )
        )

        # Corrected final LayerNorm
        self.norm = nn.LayerNorm(
            256,
            eps=1e-6
        )

        nn.init.ones_(
            self.norm.weight
        )

        nn.init.zeros_(
            self.norm.bias
        )

        self.H1 = 16
        self.W1 = 192

        self.H2 = 8
        self.W2 = 192

        self.H3 = 4
        self.W3 = 192

    def get_beta(self):

        return torch.sigmoid(
            self.beta_logit
        )

    def forward(
        self,
        x,
        return_debug=False
    ):

        B = x.shape[0]

        # ------------------------------------------------------------------------------------------
        # Patch embedding
        # ------------------------------------------------------------------------------------------

        x = self.core.patch_embed(x)

        x = (
            x
            +
            self.core.pos_embed
        )

        x = self.core.pos_drop(x)

        # ------------------------------------------------------------------------------------------
        # Stage 1
        # ------------------------------------------------------------------------------------------

        for block in self.core.stage1:
            x = block(x)

        # ------------------------------------------------------------------------------------------
        # Vertical downsample -> H=8
        # ------------------------------------------------------------------------------------------

        x, H2, W2 = self.core.sub1(
            x,
            self.H1,
            self.W1
        )

        if (H2, W2) != (8, 192):
            raise RuntimeError(
                f"Unexpected Stage2 geometry: {H2}x{W2}"
            )

        # ------------------------------------------------------------------------------------------
        # Stage 2
        # ------------------------------------------------------------------------------------------

        for block in self.core.stage2:
            x = block(x)

        if x.shape[1:] != (1536, 128):
            raise RuntimeError(
                f"Unexpected Stage2 tokens: {tuple(x.shape)}"
            )

        stage2_map = (
            x
            .transpose(1, 2)
            .reshape(
                B,
                128,
                8,
                192
            )
        )

        # ------------------------------------------------------------------------------------------
        # Auxiliary branch
        # ------------------------------------------------------------------------------------------

        aux_map = self.aux_branch(
            stage2_map
        )

        if aux_map.shape[1:] != (256, 4, 192):
            raise RuntimeError(
                f"Unexpected auxiliary map: {tuple(aux_map.shape)}"
            )

        # ------------------------------------------------------------------------------------------
        # Base SVTR path
        # ------------------------------------------------------------------------------------------

        base, H3, W3 = self.core.sub2(
            x,
            H2,
            W2
        )

        if (H3, W3) != (4, 192):
            raise RuntimeError(
                f"Unexpected Stage3 geometry: {H3}x{W3}"
            )

        for block in self.core.stage3:
            base = block(base)

        if base.shape[1:] != (768, 256):
            raise RuntimeError(
                f"Unexpected base tokens: {tuple(base.shape)}"
            )

        # ------------------------------------------------------------------------------------------
        # Aux map -> tokens
        # ------------------------------------------------------------------------------------------

        aux_tokens = (
            aux_map
            .flatten(2)
            .transpose(1, 2)
            .contiguous()
        )

        if aux_tokens.shape != base.shape:
            raise RuntimeError(
                f"Base/Aux mismatch: "
                f"{tuple(base.shape)} vs {tuple(aux_tokens.shape)}"
            )

        # ------------------------------------------------------------------------------------------
        # Gated residual fusion
        # ------------------------------------------------------------------------------------------

        beta = self.get_beta()

        fused = (
            base
            +
            beta
            *
            aux_tokens
        )

        # ------------------------------------------------------------------------------------------
        # Corrected Final LayerNorm
        # ------------------------------------------------------------------------------------------

        fused = self.norm(
            fused
        )

        # ------------------------------------------------------------------------------------------
        # Tokens -> map
        # ------------------------------------------------------------------------------------------

        fused_map = (
            fused
            .transpose(1, 2)
            .reshape(
                B,
                256,
                4,
                192
            )
        )

        # ------------------------------------------------------------------------------------------
        # Final feature projection
        # ------------------------------------------------------------------------------------------

        features = self.core.avg_pool(
            fused_map
        )

        features = self.core.last_conv(
            features
        )

        features = self.core.last_act(
            features
        )

        features = self.core.last_drop(
            features
        )

        features = (
            features
            .squeeze(2)
            .transpose(1, 2)
            .contiguous()
        )

        if features.shape[1:] != (192, 192):
            raise RuntimeError(
                f"Unexpected features: {tuple(features.shape)}"
            )

        if return_debug:

            return {
                "stage2_map": stage2_map,
                "aux_map": aux_map,
                "base_tokens": base,
                "aux_tokens": aux_tokens,
                "fused_tokens": fused,
                "features": features,
                "beta": beta,
            }

        return features


