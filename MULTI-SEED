class SVTRMatchedAuxCTC(nn.Module):

    def __init__(
        self,
        mode,
        num_classes=68
    ):

        super().__init__()

        self.mode = mode

        self.backbone = (
            SVTRMatchedAuxBackbone(
                mode
            )
        )

        self.ctc_head = OfficialCTCHead(
            in_channels=192,
            out_channels=num_classes
        )

    def forward(
        self,
        x,
        rtl=True
    ):

        features = self.backbone(x)

        logits = self.ctc_head(
            features
        )

        if rtl:

            logits = torch.flip(
                logits,
                dims=[1]
            )

        return logits


