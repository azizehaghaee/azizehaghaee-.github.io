    ):

        return {
            "checkpoint_type":
                checkpoint_type,

            "mode":
                mode,

            "seed":
                int(seed),

            "parameters":
                total_params,

            "initial_parameter_hash":
                init_hash,

            "resume_epoch":
                int(
                    epoch_to_resume
                ),

            "resume_batch":
                int(
                    batch_to_resume
                ),

            "epoch_loss_sum":
                float(
