def optimizer_to_device(
    optimizer,
    device
):

    for state in optimizer.state.values():

        for k, v in state.items():

            if torch.is_tensor(v):

                state[k] = v.to(
                    device
                )


# ==================================================================================================
# 19. INITIAL PARAMETER HASH
#
# Used only as a reproducibility fingerprint.
# For a fresh paired seed, No-Contrast and Signed should have identical parameter initialization.
# ==================================================================================================

def parameter_hash(model):

    h = hashlib.sha256()

    for p in model.parameters():

        arr = (
            p.detach()
            .cpu()
            .contiguous()
            .numpy()
        )

        h.update(
            arr.tobytes()
        )

    return h.hexdigest()


