# ==================================================================================================
# 12. CTC DECODER
# ==================================================================================================

id2char = {
    i + 1: ch
    for i, ch in enumerate(charset)
}


def decode_ctc_ids(ids):

    result = []

    previous = None

    for idx in ids:

        idx = int(idx)

        if idx == BLANK_ID:

            previous = idx
            continue

        if idx != previous:

            if idx in id2char:

                result.append(
                    id2char[idx]
                )

        previous = idx

    return "".join(
        result
    )


def decode_logits(logits):

    predicted = (
        logits
        .argmax(dim=-1)
        .detach()
        .cpu()
    )

    return [
        decode_ctc_ids(
            seq.tolist()
        )
        for seq in predicted
    ]


# ==================================================================================================
# 13. EDIT DISTANCE
# ==================================================================================================

def edit_distance(a, b):

    if a == b:
        return 0

    if len(a) == 0:
        return len(b)

    if len(b) == 0:
        return len(a)

    if len(a) < len(b):
        a, b = b, a

    previous = list(
        range(
            len(b) + 1
        )
    )

    for i, ca in enumerate(
        a,
        1
    ):

        current = [i]

        for j, cb in enumerate(
            b,
            1
        ):

            current.append(
                min(
                    current[j - 1] + 1,
                    previous[j] + 1,
                    previous[j - 1]
                    +
                    (ca != cb)
                )
            )

        previous = current

    return previous[-1]


# ==================================================================================================
# 14. METRICS
# ==================================================================================================

def calculate_metrics(
    predictions,
    references
):

    char_edits = 0
    char_total = 0

    word_edits = 0
    word_total = 0

    exact_lines = 0

    ned_sum = 0.0

    for pred, gt in zip(
        predictions,
        references
    ):

        cd = edit_distance(
            list(pred),
            list(gt)
        )

        char_edits += cd
        char_total += len(gt)

        pred_words = pred.split()
        gt_words = gt.split()

        wd = edit_distance(
            pred_words,
            gt_words
        )

        word_edits += wd
        word_total += len(gt_words)

        if pred == gt:
            exact_lines += 1

        denominator = max(
            len(pred),
            len(gt),
            1
        )

        ned = (
            1.0
            -
            cd
            /
            denominator
        )

        ned_sum += max(
            0.0,
            ned
        )

    n = max(
        len(references),
        1
    )

    return {
        "cer":
            char_edits
            /
            max(char_total, 1),

        "wer":
            word_edits
            /
            max(word_total, 1),

        "line_acc":
            exact_lines
            /
            n,

        "mean_1_ned":
            ned_sum
            /
            n,
    }


